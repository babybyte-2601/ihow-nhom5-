# iHOW - Cấu hình mẫu cho Streamlit secrets
# Đổi tên file này thành .streamlit/secrets.toml trên máy cục bộ
# Hoặc thêm các biến này vào mục Secrets của Streamlit Community Cloud.
# TUYỆT ĐỐI KHÔNG commit file secrets.toml thật chứa API key lên GitHub!

GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"

# Tùy chọn cấu hình mô hình mặc định (tùy chọn)
# Mặc định hệ thống tự động ưu tiên gemini-3.5-flash-lite (bình thường) hoặc gemini-3.8-flash (nâng cao)
GEMINI_MODEL = "gemini-3.5-flash-lite"

